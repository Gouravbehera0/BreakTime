# ==============================================================================
# BreakTym Web Application — Supabase Public Configuration
# ==============================================================================
# Copy this file to .env or .env.local and fill in your Supabase project keys.
#
# IMPORTANT SECURITY NOTICE:
# Any variable starting with VITE_ is bundled into client-side JavaScript.
# NEVER place secret credentials here!
# - DO NOT put: Supabase service_role key
# - DO NOT put: Database password or connection URI
# - DO NOT put: SMS/Twilio provider secrets
# - DO NOT put: Private third-party API secrets
#
# Database security is enforced on the server via Supabase Row Level Security (RLS).
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (safe for client-side usage with RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy alias (optional, fallback if VITE_SUPABASE_PUBLISHABLE_KEY is unset)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
