# ==============================================================================
# BreakTym Workspace — Supabase Environment Configuration Template
# ==============================================================================
# For the web client, place these variables in: apps/web/.env
#
# IMPORTANT: Never commit actual project keys or backend secrets to Git!
# ==============================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (client-safe key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy alias (also supported by client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web Push Notifications (Public VAPID Key)
# Generate keypair via: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

